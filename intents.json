{
  "SCROLL_DOWN": "window.scrollBy(0, 300)",
  "SCROLL_UP": "window.scrollBy(0, -300)",
  "READ_SECTION": "/* handled by your TTS/reader */",
  "REFRESH_PAGE": "location.reload()",
  "NEW_TAB": "window.open('about:blank')",
  "CLOSE_TAB": "window.close()",
  "NEXT_TAB": "window.dispatchEvent(new KeyboardEvent('keydown', {ctrlKey:true, key:'Tab'}))",
  "PREVIOUS_TAB": "/* ctrl+shift+tab via extension background script */",
  "GO_BACK": "history.back()",
  "GO_FORWARD": "history.forward()",
  "ZOOM_IN": "document.body.style.zoom = (parseFloat(document.body.style.zoom||1)+0.1).toString()",
  "ZOOM_OUT": "document.body.style.zoom = (parseFloat(document.body.style.zoom||1)-0.1).toString()",
  "FULL_SCREEN": "document.documentElement.requestFullscreen && document.documentElement.requestFullscreen()",
  "EXIT_FULL_SCREEN": "document.exitFullscreen && document.exitFullscreen()",
  "OPEN_GMAIL": "window.location.href='https://mail.google.com/'",
  "OPEN_YOUTUBE": "window.location.href='https://www.youtube.com/'",
  "OPEN_GOOGLE": "window.location.href='https://www.google.com/'",
  "OPEN_FACEBOOK": "window.location.href='https://www.facebook.com/'",
  "OPEN_INSTAGRAM": "window.location.href='https://www.instagram.com/'",
  "OPEN_TWITTER": "window.location.href='https://twitter.com/'",
  "OPEN_LINKEDIN": "window.location.href='https://www.linkedin.com/'",
  "OPEN_WHATSAPP_WEB": "window.location.href='https://web.whatsapp.com/'",
  "OPEN_DRIVE": "window.location.href='https://drive.google.com/'",
  "OPEN_MAPS": "window.location.href='https://maps.google.com/'",
  "OPEN_CALENDAR": "window.location.href='https://calendar.google.com/'",
  "OPEN_NEWS": "window.location.href='https://news.google.com/'",
  "BOOKMARK_PAGE": "/* implement via extension APIs */",
  "OPEN_BOOKMARKS": "/* implement via extension UI */",
  "OPEN_DOWNLOADS": "/* chrome://downloads via extension */",
  "OPEN_SETTINGS": "/* chrome://settings via extension */",
  "CLOSE_BROWSER": "/* handled by extension/native host */"
}
